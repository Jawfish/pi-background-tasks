{
  "name": "@jawfish/pi-background-tasks",
  "version": "0.1.0",
  "description": "Session-scoped background shell tasks for Pi",
  "keywords": [
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/jawfish/pi-background-tasks#readme",
  "bugs": {
    "url": "https://github.com/jawfish/pi-background-tasks/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jawfish/pi-background-tasks.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
